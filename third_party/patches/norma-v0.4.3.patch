+	cmd.Env = append(os.Environ(), "NORMA_MCP_TEST_CHILD=1")
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	client, err := NewStdioClientWithCommand(ctx, "sentinel", cmd)
